# DB settings
DB_USER=postgres
DB_PASS=your_secure_password_here
DB_NAME=links

# App settings
LINK_LENGHT=6
DEFAULT_EXPIRATION_MINUTES=60

# JWT settings (обязательно измените в production!)
SECRET_KEY=your_super_secret_key_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS settings
CORS_ORIGINS=http://localhost:80

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASS=

# Cleanup settings (days)
UNUSED_LINKS_DAYS=30

# Docker settings
APP_PORT=8000
WORKERS=4
